# Conexión a Postgres. En Vercel la integración de Neon crea DATABASE_URL y DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://kim:kim@localhost:5432/kim
# Opcional: conexión directa (sin pooler) para migraciones. Si no existe se usa DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Secreto para firmar los JWT de sesión (mínimo 32 caracteres). Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
# Zona horaria del estudio (se usa para "hoy", agenda y creación de clases)
STUDIO_TZ=America/Bogota
# Contraseña inicial de las cuentas creadas por el seed
SEED_PASSWORD=demo1234
